# Mẫu cấu hình cho Mahilo-Scala. Cách dùng:
#   1. Sao chép file này thành .env  (Windows: copy .env.example .env ; macOS/Linux: cp .env.example .env)
#   2. Điền API key của bạn vào .env
#   3. Chạy server từ thư mục gốc repo: sbt "bootstrap/runMain mahilo.bootstrap.ServerMain"
# File .env đã nằm trong .gitignore, KHÔNG commit nó. Biến môi trường thật (nếu có) được ưu tiên hơn file này.

# ---------- Chọn LLM ----------
# anthropic = Claude | openai = GPT | langchain4j = GPT qua LangChain4j | scripted = bộ não giả lập, không cần key
MAHILO_LLM=anthropic

# Key của Claude, lấy ở https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Model (bỏ trống = mặc định: claude-opus-5-5 cho anthropic, gpt-4o-mini cho openai).
# Muốn rẻ và nhanh hơn: claude-sonnet-5-5 hoặc claude-haiku-5-5
MAHILO_LLM_MODEL=claude-opus-5-5

# (Chỉ cho anthropic) Mức suy nghĩ: low | medium | high | xhigh | max. Bỏ trống = mặc định của model (medium với Opus 5.5)
MAHILO_LLM_EFFORT=
# (Chỉ cho anthropic) Khi Claude từ chối vì bộ lọc an toàn, server tự thử lại bằng model dự phòng. Đặt false để tắt.
MAHILO_LLM_FALLBACKS=true

# Dùng GPT thay cho Claude thì đặt MAHILO_LLM=openai và điền key này
# OPENAI_API_KEY=sk-...
# Dùng Ollama/vLLM thì thêm: MAHILO_LLM_BASE_URL=http://localhost:11434/v1

# ---------- Chọn ví dụ ----------
# dispatcher = Dispatcher ↔ Plumber | team = SalesAgent, MarketingAgent (LangGraph4j), ProductAgent (PydanticAI)
MAHILO_EXAMPLE=dispatcher

# ---------- Server ----------
PORT=8000
MAHILO_DB=mahilo.db
# Ký HMAC cho tin giữa các agent (tuỳ chọn)
# MAHILO_SECRET_KEY=doi-thanh-chuoi-bi-mat
# Policy bật sẵn (tuỳ chọn), vd: anti_loop,message_length
MAHILO_POLICIES=

# ---------- PydanticAI (chỉ cần cho ví dụ team) ----------
# Bật dòng này khi đã chạy service Python ở cổng 8001 (xem docs/user-guide.md, mục 3)
# MAHILO_PYDANTICAI_URL=http://localhost:8001
